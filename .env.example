# 어장 추천 서비스 — 환경 변수 견본. 이 파일을 .env 로 복사한 뒤 값을 채운다 (.env 는 저장소에 올리지 않음)
# 세 서버(web · api · ai)가 모두 저장소 맨 위의 이 .env 하나를 읽는다.

# ── DB (MariaDB 10.11 이상) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
# 처음 한 번 데이터베이스 · 계정을 만들 때만 쓰는 관리자 계정 (ai/scripts/init_db.py)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
# 리눅스에서 root 가 소켓 인증이면: DB_ROOT_SOCKET=/run/mysqld/mysqld.sock
DB_ROOT_SOCKET=
# 서비스 계정 비밀번호 — 직접 정한다
RECO_DB_PASSWORD=
APP_DB_PASSWORD=

# ── 서버끼리 쓰는 내부 토큰 (아무 긴 문자열. 예: python -c "import secrets;print(secrets.token_urlsafe(32))") ──
INTERNAL_TOKEN=

# ── 시연: 고정된 '오늘'. 비우면 실제 오늘. 시연 자료는 2026-10-14 까지 → 2026-10-15 ──
DEMO_TODAY=2026-10-15

# ── 공공 OpenAPI 키 (3단계 수집) ─────────────────────────
DATA_GO_KR_KEY=
KMA_AUTH_KEY=

# ── 회원 (2단계) ───────────────────────────────────────
# 이 이메일이 검증되면 관리자(ADMIN). 여럿이면 쉼표로
ADMIN_EMAILS=
WEB_BASE_URL=http://localhost:3000
# 메일 — 개발 · 수업은 Mailpit(SMTP 1025, 받은 편지함 http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@fishreco.local
# 소셜 로그인 — 비워 두면 그 버튼은 '설정 안 됨'
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── RAG (4단계) ────────────────────────────────────────
# ollama(기본) · openai · claude
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAG_PER_MINUTE=5
